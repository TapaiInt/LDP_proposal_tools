# One entry per tenant: tenant:key. Tenant = letters, digits or '-' (max 20). Key = at least 16 characters, random.
# Generate a key:  python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEYS=presales:CHANGE-ME-to-a-long-random-key

# Signs the download links. Long random string, identical on every worker and replica.
LINK_SECRET=CHANGE-ME-to-a-long-random-string

# The URL end users and the platform use to reach this service (no trailing slash). Used in download links and OpenAPI.
PUBLIC_BASE_URL=https://tools.example.internal

# Optional
# MAX_BODY_BYTES=5242880
# LINK_TTL_SECONDS=900
# ARTIFACT_ROOT=/data/artifacts
