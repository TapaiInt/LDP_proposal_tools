{
  "openapi": "3.1.0",
  "info": {
    "title": "Presales estimation tools",
    "description": "Tool endpoints for the proposal and estimation agents. See v4/integration/IMPLEMENTATION_GUIDE.md.",
    "version": "v4.1"
  },
  "servers": [
    {
      "url": "https://ldp-proposal-tools.onrender.com"
    }
  ],
  "paths": {
    "/v1/tools/save_artifact": {
      "post": {
        "tags": [
          "tools"
        ],
        "summary": "save_artifact",
        "description": "Store text or a JSON object as a named artifact in the run's folder and record its sha256. Raw agent outputs (estimation_pass*, estimation_revision*, reviewer_findings*, scope_summary*) are immutable. Use this once for each sub-agent reply, then refer to it by name.",
        "operationId": "save_artifact",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "run_id": {
                    "type": "string",
                    "description": "Run identifier, e.g. client-date"
                  },
                  "name": {
                    "type": "string",
                    "description": "Artifact name, e.g. estimation_pass2.json"
                  },
                  "content": {
                    "type": "string",
                    "description": "Text to store (exactly one of content or json_value)"
                  },
                  "json_value": {
                    "type": "object",
                    "description": "JSON object to store"
                  },
                  "overwrite": {
                    "type": "boolean",
                    "description": "Replace an existing non-immutable artifact"
                  },
                  "append": {
                    "type": "boolean",
                    "description": "Add content to the end of the artifact (created when missing) instead of replacing it; for saving a long document in parts"
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "run_id",
                  "name"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Tool result. Always 200; check `ok`.",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true,
                  "type": "object",
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          },
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/tools/promote_artifact": {
      "post": {
        "tags": [
          "tools"
        ],
        "summary": "promote_artifact",
        "description": "Copy an existing artifact to a new name on the server, byte for byte, and record its sha256. Use it to turn the draft that passed calc_estimate into the final estimation_pass2.json / estimation_revision.json (or a _retryN name) instead of re-sending the whole JSON. For estimate names the source must be a complete estimate. The new name is created once; an existing name is never overwritten.",
        "operationId": "promote_artifact",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "run_id": {
                    "type": "string",
                    "description": "Run identifier"
                  },
                  "source": {
                    "type": "string",
                    "description": "Existing artifact to copy, e.g. the draft file that passed calc_estimate"
                  },
                  "name": {
                    "type": "string",
                    "description": "New artifact name, e.g. estimation_pass2.json"
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "run_id",
                  "source",
                  "name"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Tool result. Always 200; check `ok`.",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true,
                  "type": "object",
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          },
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/tools/get_artifact": {
      "post": {
        "tags": [
          "tools"
        ],
        "summary": "get_artifact",
        "description": "Read a text artifact (sliced by offset and max_chars). Binary files return metadata only.",
        "operationId": "get_artifact",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "run_id": {
                    "type": "string",
                    "description": "Run identifier"
                  },
                  "name": {
                    "type": "string",
                    "description": "Artifact name"
                  },
                  "offset": {
                    "type": "integer"
                  },
                  "max_chars": {
                    "type": "integer"
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "run_id",
                  "name"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Tool result. Always 200; check `ok`.",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true,
                  "type": "object",
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          },
          {
            "HTTPBearer": []
          }
        ]
      }
    },
