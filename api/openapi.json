        ]
      }
    },
    "/v1/tools/calc_estimate": {
      "post": {
        "tags": [
          "tools"
        ],
        "summary": "calc_estimate",
        "description": "Run the deterministic calculator on an estimate artifact: PERT, totals, overheads, by-type, team hours, timeline, 25 structural checks. Writes the derived artifact and returns a compact summary. Use after every estimator output; blocking failures mean the estimate must be retried.",
        "operationId": "calc_estimate",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "run_id": {
                    "type": "string",
                    "description": "Run identifier"
                  },
                  "estimate": {
                    "type": "string",
                    "description": "Artifact name of the estimator JSON (raw reply with a ```json fence is accepted)"
                  },
                  "previous": {
                    "type": "string",
                    "description": "Artifact name of the previous estimate, for a revision delta"
                  },
                  "hours_per_fte_week": {
                    "type": "number"
                  },
                  "out": {
                    "type": "string",
                    "description": "Derived artifact name (default estimation_derived.json)"
                  },
                  "include_derived": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "run_id",
                  "estimate"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Tool result. Always 200; check `ok`.",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true,
                  "type": "object",
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          },
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/tools/ensemble_select": {
      "post": {
        "tags": [
          "tools"
        ],
        "summary": "ensemble_select",
        "description": "Given several independent estimator runs (artifact names), select the median run, copy it byte-for-byte to select_as, write the derived artifact and a spread report.",
        "operationId": "ensemble_select",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "run_id": {
                    "type": "string",
                    "description": "Run identifier"
                  },
                  "runs": {
                    "items": {
                      "type": "string"
                    },
                    "type": "array",
                    "description": "Artifact names of the runs"
                  },
                  "out": {
                    "type": "string",
                    "description": "Derived artifact name"
                  },
                  "report": {
                    "type": "string",
                    "description": "Report artifact name"
                  },
                  "select_as": {
                    "type": "string",
                    "description": "Name for the selected raw estimate (default estimation_pass2.json)"
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "run_id",
                  "runs"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Tool result. Always 200; check `ok`.",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true,
                  "type": "object",
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          },
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/tools/prepare_review": {
      "post": {
        "tags": [
          "tools"
        ],
        "summary": "prepare_review",
        "description": "Create the reviewer input: the estimate without the estimator's reasoning, plus calculator numbers.",
        "operationId": "prepare_review",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "run_id": {
                    "type": "string",
                    "description": "Run identifier"
                  },
                  "estimate": {
                    "type": "string",
                    "description": "Estimate artifact name"
                  },
                  "derived": {
                    "type": "string",
                    "description": "Derived artifact name"
                  },
                  "out": {
                    "type": "string",
                    "description": "Output artifact name"
                  },
                  "include_content": {
                    "type": "boolean",
                    "description": "Also return the JSON text"
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "run_id",
                  "estimate",
                  "derived"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Tool result. Always 200; check `ok`.",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true,
                  "type": "object",
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          },
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/tools/build_workbook": {
      "post": {
        "tags": [
          "tools"
        ],
        "summary": "build_workbook",
        "description": "Build the estimation workbook (.xlsx) with live formulas from the estimate and derived artifacts; verifies totals independently.",
        "operationId": "build_workbook",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "run_id": {
                    "type": "string",
                    "description": "Run identifier"
                  },
                  "estimate": {
                    "type": "string",
                    "description": "Estimate artifact name"
                  },
                  "derived": {
                    "type": "string",
                    "description": "Derived artifact name"
                  },
                  "out_name": {
                    "type": "string",
                    "description": "Workbook artifact name ending in .xlsx, e.g. Estimation_Client_V1.0.xlsx"
                  },
                  "client": {
                    "type": "string",
                    "description": "Client name"
                  },
                  "version": {
                    "type": "string",
                    "description": "Version"
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "draft",
                      "delivery_reviewed",
                      "approved"
                    ],
                    "description": "Estimate state"
                  },
                  "draft": {
                    "type": "string",
                    "description": "Comma-separated failed blocking check ids; stamps the workbook DRAFT"
                  },
                  "sources": {
                    "type": "string",
                    "description": "Source document names"
                  },
                  "clarifications": {
                    "type": [
                      "array",
                      "string",
                      "null"
                    ],
                    "description": "List of Q&A objects, or the name of a JSON artifact"
                  },
                  "check": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "run_id",
                  "estimate",
                  "derived",
                  "out_name"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Tool result. Always 200; check `ok`.",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true,
                  "type": "object",
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          },
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/tools/build_docx": {
      "post": {
        "tags": [
          "tools"
        ],
        "summary": "build_docx",
        "description": "Convert the client proposal (the Proposal_*.md artifact) into a Word .docx in INT's proposal style: cover page, numbered headings, tables, running header and footer. Call it after the proposal text is final and the consistency checks have run.",
        "operationId": "build_docx",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "run_id": {
                    "type": "string",
                    "description": "Run identifier"
                  },
                  "source": {
                    "type": "string",
                    "description": "Proposal markdown artifact name, e.g. Proposal_Client_Title_V1.0.md"
                  },
                  "out_name": {
                    "type": "string",
                    "description": "Word artifact name ending in .docx, e.g. Proposal_Client_Title_V1.0.docx"
                  },
                  "version": {
                    "type": "string",
                    "description": "Version shown in the page header, e.g. V1.0 (default: read from the cover page)"
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "run_id",
                  "source",
                  "out_name"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Tool result. Always 200; check `ok`.",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true,
                  "type": "object",
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          },
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/tools/build_diagram": {
      "post": {
        "tags": [
          "tools"
        ],
        "summary": "build_diagram",
        "description": "Render a user-journey or process flow as a PNG artifact in INT's proposal style. Input is a step list, one step per line: `id | Title | Description | next`, where next is a comma-separated list of ids with an optional `:label` (for example `S2:Approved, S3:Returned`). A step that points back to an earlier step is drawn as a loop. Up to 24 steps. Returns the flow as a markdown step_table to place under the picture. In the proposal, embed it with `![Caption](name.png)` on its own line; build_docx puts it in the Word file.",
        "operationId": "build_diagram",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "run_id": {
                    "type": "string",
                    "description": "Run identifier"
                  },
                  "out_name": {
                    "type": "string",
                    "description": "PNG artifact name, e.g. journey_approver.png"
                  },
                  "steps": {
                    "type": "string",
                    "description": "The step list, one step per line: id | Title | Description | next"
                  },
                  "title": {
                    "type": "string",
                    "description": "Heading drawn above the diagram"
                  },
                  "direction": {
                    "type": "string",
                    "description": "down (default) or right; use right only for short, mostly linear flows"
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "run_id",
                  "out_name",
                  "steps"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Tool result. Always 200; check `ok`.",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true,
                  "type": "object",
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          },
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/tools/render_diagram": {
      "post": {
        "tags": [
          "tools"
        ],
        "summary": "render_diagram",
        "description": "Render a proposal diagram as a PNG artifact in INT's style through a headless browser. kind=architecture: spec is JSON {\"layers\": [{\"name\": \"Users & channels\", \"items\": [{\"name\": \"Employee portal\", \"detail\": \"Responsive web\", \"tag\": \"INT Recommended\"}]}], \"integrations\": [{\"name\": \"SAP\", \"detail\": \"Employee master\", \"tag\": \"Existing\"}], \"integration_note\": \"...\"} with 2-8 layers top (users) to bottom (platform), 1-8 items each, tag Client-Mandated | Existing | INT Recommended | To Be Confirmed. kind=journey: spec is a step list, one step per line `id | Role | Action | next` (next = ids with optional :label); each role becomes a swimlane (max 6), steps with 2+ exits get a decision gateway, loops back are dashed; returns step_table. kind=mermaid: spec is Mermaid source (sequenceDiagram, gantt, flowchart, stateDiagram). Embed with `![Caption](name.png)` on its own line; build_docx puts it in the Word file.",
        "operationId": "render_diagram",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "run_id": {
                    "type": "string",
                    "description": "Run identifier"
                  },
                  "out_name": {
                    "type": "string",
                    "description": "PNG artifact name, e.g. architecture.png, journey_approver.png"
                  },
                  "kind": {
                    "type": "string",
                    "enum": [
                      "architecture",
                      "journey",
                      "mermaid"
                    ],
                    "description": "Diagram kind"
                  },
                  "spec": {
                    "type": [
                      "string",
                      "object"
                    ],
                    "description": "architecture: JSON object (or its text); journey: step list text; mermaid: Mermaid source text"
                  },
                  "title": {
                    "type": "string",
                    "description": "Heading drawn above the diagram"
                  },
                  "subtitle": {
                    "type": "string",
                    "description": "One line under the heading, e.g. 'Proposed, validated in discovery'"
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "run_id",
                  "out_name",
                  "kind",
                  "spec"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Tool result. Always 200; check `ok`.",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true,
                  "type": "object",
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          },
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/v1/tools/check_consistency": {
      "post": {
        "tags": [
          "tools"
        ],
        "summary": "check_consistency",
        "description": "Run the scripted consistency checks over the run's artifacts. Needs Proposal_*.md, Presales_Review_Notes_*.md, Estimation_*.xlsx, the estimate and the derived artifact saved in the run. Returns failures and warnings.",
        "operationId": "check_consistency",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "run_id": {
                    "type": "string",
                    "description": "Run identifier"
                  },
                  "forbid": {
                    "type": "string",
                    "description": "Comma-separated names of other clients that must not appear"
                  },
                  "expose_hours": {
                    "type": "boolean"
                  },
                  "estimate": {
