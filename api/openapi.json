    "/v1/tools/build_workbook": {
      "post": {
        "tags": [
          "tools"
        ],
        "summary": "build_workbook",
        "description": "Build the estimation workbook (.xlsx) with live formulas from the estimate and derived artifacts; verifies totals independently.",
        "operationId": "build_workbook",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "properties": {
                  "run_id": {
                    "type": "string",
                    "description": "Run identifier"
                  },
                  "estimate": {
                    "type": "string",
                    "description": "Estimate artifact name"
                  },
                  "derived": {
                    "type": "string",
                    "description": "Derived artifact name"
                  },
                  "out_name": {
                    "type": "string",
                    "description": "Workbook artifact name ending in .xlsx, e.g. Estimation_Client_V1.0.xlsx"
                  },
                  "client": {
                    "type": "string",
                    "description": "Client name"
                  },
                  "version": {
                    "type": "string",
                    "description": "Version"
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "draft",
                      "delivery_reviewed",
                      "approved"
                    ],
                    "description": "Estimate state"
                  },
                  "draft": {
                    "type": "string",
                    "description": "Comma-separated failed blocking check ids; stamps the workbook DRAFT"
                  },
                  "sources": {
                    "type": "string",
                    "description": "Source document names"
                  },
                  "clarifications": {
                    "type": [
                      "array",
                      "string",
                      "null"
                    ],
                    "description": "List of Q&A objects, or the name of a JSON artifact"
                  },
                  "check": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false,
                "type": "object",
                "required": [
                  "run_id",
                  "estimate",
                  "derived",
                  "out_name"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Tool result. Always 200; check `ok`.",
            "content": {
              "application/json": {
                "schema": {
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "error": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true,
                  "type": "object",
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          },
          {
            "HTTPBearer": []
          }
        ]
      }
    },
